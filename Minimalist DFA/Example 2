#include <stdio.h>
#include <stdbool.h>

typedef enum {
    Q0,
    Q1,
    Q2,
    Q34,
    QTRAP
} State;

State transition(State current, char c) {
    switch (current) {

        case Q0:
            if (c == '/')
                return Q1;
            return QTRAP;

        case Q1:
            if (c == '/')
                return Q2;
            return QTRAP;

        case Q2:
            if (c == 'a')
                return Q34;
            return QTRAP;

        case Q34:
            if (c == 'a')
                return Q34;
            return QTRAP;

        case QTRAP:
            return QTRAP;
    }

    return QTRAP;
}

bool run_dfa(const char *input) {
    State current = Q0;

    for (int i = 0; input[i] != '\0'; i++) {
        current = transition(current, input[i]);
    }

    return current == Q34;
}

int main() {

    const char *test_cases[] = {
        "//a",
        "//aa",
        "//aaa",
        "//aaaa",
        "//",
        "/",
        "/*a*/",
        "//a/",
        "///a"
    };

    int num_tests = sizeof(test_cases) / sizeof(test_cases[0]);

    printf("=== EXAMPLE 2: MINIMIZED DFA ===\n\n");

    for (int i = 0; i < num_tests; i++) {

        bool result = run_dfa(test_cases[i]);

        printf("Input: %-12s Result: %s\n",
               test_cases[i],
               result ? "ACCEPT" : "REJECT");
    }

    return 0;
}
